// =============================================================================
// MANUAL SETUP FILE — not auto-applied.
//
// This is NOT dropped into the project automatically because android/ does
// not exist yet (it's generated by `flutter create`, which needs the real
// Flutter SDK — unavailable in this analysis environment). Once you run:
//
//     flutter create --org com.ufony --project-name school_bus_tracker .
//
// (from inside this school_bus_tracker/ folder, after copying lib/,
// pubspec.yaml, l10n.yaml, and assets/ into place), open the generated
// android/app/build.gradle (or build.gradle.kts) and merge in the
// `flavorDimensions`/`productFlavors` block below. It mirrors the original
// Android project's build.gradle flavor definitions field-for-field.
// =============================================================================

android {
    namespace = "com.ufony.schooldiarytracker"
    compileSdk = 35

    defaultConfig {
        // This becomes the applicationId ONLY if not overridden per-flavor
        // below. Both flavors override it, matching the original project.
        minSdk = 24
        targetSdk = 35
        versionCode = flutterVersionCode.toInteger()
        versionName = flutterVersionName
    }

    flavorDimensions += "normal"

    productFlavors {
        create("schoolDiaryRouteTracker") {
            dimension = "normal"
            applicationId = "com.ufony.SDTracker"
            versionCode = 50
            versionName = "1.0.5"
            resValue(type = "string", name = "app_name", value = "SD Tracker")
            // Original used manifestPlaceholders[appIcon] = "@drawable/school_bus"
            // for a runtime-selected launcher icon via placeholder. Flutter's
            // standard approach is a per-flavor mipmap/ic_launcher set instead
            // (see "Launcher icons" note below) — functionally equivalent,
            // cleaner in Flutter's build system.
        }
        create("euroWebGenieRouteTracker") {
            dimension = "normal"
            applicationId = "com.ufony.schooldiarytracker"
            versionCode = 132
            versionName = "3.0.1"
            resValue(type = "string", name = "app_name", value = "Euro Tracker")
        }
    }
}

// -----------------------------------------------------------------------------
// Launcher icons (manual step):
// Original: single icon set + manifestPlaceholders selecting @drawable/school_bus
//           vs @drawable/bus per flavor.
// Flutter:  create android/app/src/schoolDiaryRouteTracker/res/mipmap-*/ic_launcher.png
//           and android/app/src/euroWebGenieRouteTracker/res/mipmap-*/ic_launcher.png
//           with the real brand artwork (not available in the handed-over
//           source — these are binary drawables from the original res/
//           folder that need to be re-exported at each density, or
//           regenerated via the icons_launcher package already added to
//           pubspec.yaml).
// -----------------------------------------------------------------------------

